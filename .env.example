PHC_LIVE_PAYMENTS_ENABLED=false
PHC_ENVIRONMENT=production
SUPABASE_URL=
PHC_SUPABASE_SERVER_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PHC_ADMIN_TOKEN=

# Dashboard V2: staging first. Do not enable until reviewed SQL and Auth allowlist exist.
PHC_DASHBOARD_ENABLED=false
# Supabase publishable/legacy anon key for Auth REST calls (server env; never service_role here).
PHC_SUPABASE_AUTH_KEY=

# Booking alerts: server-only. Keep OFF in all deploy previews.
PHC_BOOKING_ALERTS_ENABLED=false
PHC_EMAIL_ALERTS_ENABLED=false
RESEND_API_KEY=
PHC_ALERT_EMAIL_FROM=
PHC_WHATSAPP_ALERTS_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Copy a supported version shown by your Meta API Setup dashboard; no guessed default.
WHATSAPP_API_VERSION=
WHATSAPP_ALERT_TEMPLATE=phc_booking_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
